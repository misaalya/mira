#!/bin/sh
# VolumeCtl — top-bar sound popup launcher (SoundPanel) and pactl helpers.
#
#   VolumeCtl popup [--pointer]  toggle SoundPanel under the bar
#   VolumeCtl close              close any open bar popup
#   VolumeCtl state              JSON: vol, mute, mic, micmute
#   VolumeCtl device             description of the default output
#   VolumeCtl set N | mic N      set output / input volume (0..100%, unmutes)
#   VolumeCtl mute | micmute     toggle mute

pct() {
    raw=$(pactl "$1" "$2" 2>/dev/null) || { printf '0\n'; return; }
    v=${raw%%\%*}
    v=${v##* }
    case "$v" in
        ''|*[!0-9]*) printf '0\n' ;;
        *) printf '%s\n' "$v" ;;
    esac
}

yes_no() {
    case "$(pactl "$1" "$2" 2>/dev/null)" in
        *yes*) printf 'true\n' ;;
        *)     printf 'false\n' ;;
    esac
}

clamp_pct() {
    v=${1:-0}
    v=${v%\%}
    case "$v" in
        -*|''|*[!0-9]*) v=0 ;;
    esac
    [ "$v" -gt 100 ] && v=100
    printf '%s\n' "$v"
}

case "${1:-}" in
    state)
        printf '{"vol":%s,"mute":%s,"mic":%s,"micmute":%s}\n' \
            "$(pct get-sink-volume @DEFAULT_SINK@)" \
            "$(yes_no get-sink-mute @DEFAULT_SINK@)" \
            "$(pct get-source-volume @DEFAULT_SOURCE@)" \
            "$(yes_no get-source-mute @DEFAULT_SOURCE@)"
        ;;
    device)
        sink=$(pactl get-default-sink 2>/dev/null)
        pactl -f json list sinks 2>/dev/null |
            jq -r --arg n "$sink" '.[] | select(.name == $n) | .description' 2>/dev/null
        ;;
    set)
        v=$(clamp_pct "${2:-0}")
        pactl set-sink-mute @DEFAULT_SINK@ 0
        pactl set-sink-volume @DEFAULT_SINK@ "${v}%"
        ;;
    mic)
        v=$(clamp_pct "${2:-0}")
        pactl set-source-mute @DEFAULT_SOURCE@ 0
        pactl set-source-volume @DEFAULT_SOURCE@ "${v}%"
        ;;
    mute)    pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    micmute) pactl set-source-mute @DEFAULT_SOURCE@ toggle ;;
    close)   BarPanel close-all ;;
    popup)   exec SoundPanel ${2:+"$2"} ;;
    *)
        sed -n '2,14p' "$0"
        exit 1
        ;;
esac
