#!/bin/sh
# BarPanel — top-bar popup dispatcher & single-popup coordinator.
#
#   BarPanel toggle volume|music [--pointer] [--side left|right]
#   BarPanel close-all
#
# Delegates volume/music popups to the native GTK3 binaries SoundPanel and
# MusicPanel (one-shot, 0 MiB RAM when closed) and can close every active
# bar popup (ClipPanel, NotifPanel, WifiPanel, BluetoothPanel, SoundPanel,
# MusicPanel, rofi).

RUN="${XDG_RUNTIME_DIR:-/tmp}"

kill_checked() {
    f="$RUN/$1" expect=$2
    [ -r "$f" ] || return 1
    p=$(cat "$f" 2>/dev/null)
    case $p in ''|*[!0-9]*) return 1 ;; esac
    if [ -n "$expect" ]; then
        [ "$(cat "/proc/$p/comm" 2>/dev/null)" = "$expect" ] || return 1
    fi
    kill "$p" 2>/dev/null || return 1
    printf '%s' "$p"
    return 0
}

wait_gone() {
    [ -n "$1" ] || return 0
    i=0
    while [ "$i" -lt 15 ]; do
        alive=0
        for p in $1; do
            kill -0 "$p" 2>/dev/null && alive=1
        done
        [ "$alive" = 0 ] && break
        i=$((i + 1))
        sleep 0.01
    done
}

close_all() {
    # Resident GTK daemons (instant non-blocking FIFO close).
    for spec in "clip-panel.fifo:clip-panel.pid" "notif-panel.fifo:notif-panel.pid" "wifi-panel.fifo:wifi-panel.pid"; do
        fifo="$RUN/${spec%%:*}"
        pidf="$RUN/${spec#*:}"
        if [ -p "$fifo" ] && [ -r "$pidf" ]; then
            pid=$(cat "$pidf" 2>/dev/null)
            [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && printf 'close\n' >"$fifo" 2>/dev/null
        fi
    done

    # One-shot popups holding an X11 grab: SIGTERM and wait briefly so a new
    # popup grab never collides with the outgoing one.
    pids=""
    if [ ! -p "$RUN/wifi-panel.fifo" ]; then
        p=$(kill_checked "wifi-panel.pid" "WifiPanel") && pids="$pids $p"
    fi
    for spec in \
        "bt-panel.pid:BluetoothPanel" \
        "sound-panel.pid:SoundPanel" \
        "music-panel.pid:MusicPanel" \
        "rofi.pid:rofi"; do
        p=$(kill_checked "${spec%%:*}" "${spec#*:}") && pids="$pids $p"
    done
    wait_gone "$pids"
}

case "${1:-}" in
    close-all)
        close_all
        ;;
    toggle)
        window=${2:?window name}
        shift 2
        case "$window" in
            volume|sound) exec SoundPanel "$@" ;;
            music|player) exec MusicPanel "$@" ;;
            *)
                echo "BarPanel: unknown panel '$window'" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        sed -n '2,10p' "$0"
        exit 1
        ;;
esac
