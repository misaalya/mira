#!/bin/sh
# Backdrop [--pointer] [--pid PID] [--click CMD]
#
# Dims and blurs the full monitor a popup opens on (the pointer's with
# --pointer, else bspwm's focused one). misa-backdrop raises Polybar / dock
# windows above itself so the bar stays sharp while transparent gaps behind
# floating/island topbars blur seamlessly. Behind the popup: run it right
# *before* the popup, which then maps above both. Prints the backdrop's PID;
# it goes away when PID (default: the caller) exits, when it is clicked
# (after running CMD), or when killed. See src/misa-backdrop; picom rule
# "Backdrop". Prints nothing (and the popup just opens without it) when
# misa-backdrop is not built.

bin="${0%/*}/misa-backdrop"
[ -x "$bin" ] || exit 0

ptr= pid=$PPID click=
while [ $# -gt 0 ]; do
    case $1 in
        --pointer) ptr=--pointer ;;
        --pid) pid=$2; shift ;;
        --click) click=$2; shift ;;
    esac
    shift
done

set -- $("${0%/*}/BarAnchor" $ptr)
rect=$(bspc query -T -m "${1:-focused}" 2>/dev/null | grep -o '"rectangle":{[^}]*}' | head -n 1)
x=${rect#*\"x\":}; x=${x%%,*}
y=${rect#*\"y\":}; y=${y%%,*}
w=${rect#*\"width\":}; w=${w%%,*}
h=${rect#*\"height\":}; h=${h%%\}*}
[ -n "$w" ] || exit 0
exec "$bin" "$x" "$y" "$w" "$h" --pid "$pid" ${click:+--click "$click"}
