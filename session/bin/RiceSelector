#!/bin/sh
# =============================================================
# RiceSelector — Dynamic theme switcher for Mira (CardPicker showcase).
# Adapted from gh0stzk/dotfiles (GPL-3.0).
# Original work: https://github.com/gh0stzk/dotfiles
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Copyright (C) 2026 Misaalya
# Modified 2026-11-23 by Misaalya (Debian 13)
# SPDX-License-Identifier: GPL-3.0-only
# =============================================================

MIRA_DIR="${MIRA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bspwm}"

current_theme="mira"
[ -r "$MIRA_DIR/.theme" ] && read -r current_theme < "$MIRA_DIR/.theme"

themes=$(find "$MIRA_DIR/themes/" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
[ -n "$themes" ] || exit 0

IFS='
'

selected_index=-1
index=0
for theme in $themes; do
    [ "${theme##*/}" = "$current_theme" ] && { selected_index=$index; break; }
    index=$((index + 1))
done

idx=$(
    for theme in $themes; do
        wall=$(sed -n 's/^DEFAULT_WALL="\(.*\)"$/\1/p' "$theme/theme.conf" 2>/dev/null)
        wall=$(printf '%s' "$wall" | sed "s|^\${MIRA_DIR}|$MIRA_DIR|; s|^\$MIRA_DIR|$MIRA_DIR|; s|^\${HOME}|$HOME|; s|^\$HOME|$HOME|")
        [ -f "$wall" ] || wall=$(find "$theme/walls" -maxdepth 1 -type f \( -iname '*.webp' -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' \) 2>/dev/null | sort | head -n 1)
        bar=$(sed -n 's/^main_bar="\(.*\)".*/\1/p' "$theme/theme.conf" 2>/dev/null)
        printf '%s\t\t%s\t%s\n' \
            "$(printf '%s' "${theme##*/}" | tr '[:lower:]' '[:upper:]')" \
            "$MIRA_DIR/bars/$bar/preview-bar.webp" "$wall"
    done | CardPicker --layout showcase --card 16x9 \
        --select "$selected_index" --active "$selected_index"
)
selected=
case $idx in ''|*[!0-9]*) ;; *)
    selected=$(printf '%s\n' "$themes" | sed -n "$((idx + 1))p")
    selected=${selected##*/}
    ;;
esac
unset IFS

if [ -n "$selected" ] && [ "$selected" != "$current_theme" ]; then
    printf '%s\n' "$selected" > "$MIRA_DIR/.theme"
    "$MIRA_DIR/bin/Theme.sh"
fi
