#!/bin/sh
# =============================================================
# HideNode — Minimize BSPWM windows and restore via Rofi thumbnails.
# Adapted from gh0stzk/dotfiles (GPL-3.0).
# Original Idea: https://github.com/ArnaudLelievre48/Minimizing-BSPWM
# Original work: https://github.com/gh0stzk/dotfiles
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Copyright (C) 2026 Misaalya
# Modified 2026-11-23 by Misaalya (Debian 13)
# SPDX-License-Identifier: GPL-3.0-only
# =============================================================

MIRA_DIR="${MIRA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bspwm}"
BASE="${XDG_RUNTIME_DIR:-/tmp}/mira-minimize"
THUMB_DIR="$BASE/thumbs"
META_DIR="$BASE/meta"
THEME="$MIRA_DIR/config/rofi/Hide.rasi"
mkdir -p "$THUMB_DIR" "$META_DIR"

hide() {
    wid=${1:-$(bspc query -N -n focused)}
    [ -n "$wid" ] || exit 1

    desktop=$(bspc query -D -n "$wid" --names)
    printf '%s\n' "$desktop" > "$META_DIR/$wid.desktop"

    maim -i "$wid" "$THUMB_DIR/$wid.webp" 2>/dev/null || true
    sleep 0.05
    bspc node "$wid" -g hidden=on
}

restore() {
    wid=${1:-$(bspc query -N -n any.leaf.window -d hidden | head -n 1)}
    [ -n "$wid" ] || exit 1

    rm -f "$THUMB_DIR/$wid.webp"
    bspc node "$wid" -g hidden=off
    bspc node "$wid" -t 'tiled ~'

    desktop_file="$META_DIR/$wid.desktop"
    if [ -f "$desktop_file" ]; then
        original_desktop=$(cat "$desktop_file")
        bspc node "$wid" -d "$original_desktop"
        bspc desktop "$original_desktop" -f
        bspc node "$wid" -f
        rm -f "$desktop_file"
    else
        bspc node "$wid" -d focused
    fi
}

menu() {
    entries=""
    wids=""
    k=0

    for A in "$THUMB_DIR"/*; do
        [ -f "$A" ] || continue
        wid=$(basename "$A" .webp)
        window_name=$(xprop -id "$wid" WM_NAME 2>/dev/null | cut -d '"' -f2)
        [ -n "$window_name" ] || window_name="$wid"

        entries="${entries}${k} ~ ${window_name}\000icon\037${A}\n"
        wids="${wids}${wid}|"
        k=$((k + 1))
    done

    [ -n "$entries" ] || exit 0
    BarPanel close-all >/dev/null 2>&1 || true

    window=$(printf "%b" "$entries" | rofi -dmenu -show-icons -theme "$THEME")
    [ -n "$window" ] || exit 0

    index=$(printf "%s" "$window" | cut -d ' ' -f1)
    index=$((index + 1))

    wid=$(printf "%s" "$wids" | cut -d '|' -f"$index")
    [ -n "$wid" ] && restore "$wid"
}

case "${1:-}" in
    --hide) hide "${2:-}" ;;
    --menu) menu ;;
    *) echo "Usage: HideNode --hide [WID] | --menu" >&2; exit 1 ;;
esac
