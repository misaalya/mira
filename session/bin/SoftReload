#!/bin/sh
# =============================================================
# SoftReload — Reload Mira daemons & topbar on the current X display.
# Adapted from gh0stzk/dotfiles (GPL-3.0).
# Original work: https://github.com/gh0stzk/dotfiles
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Copyright (C) 2026 Misaalya
# Modified 2026-11-23 by Misaalya (Debian 13)
# SPDX-License-Identifier: GPL-3.0-only
# =============================================================

MIRA_DIR="${MIRA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bspwm}"
DISPLAY="${DISPLAY:-:0}"
main_eww="${BSPWM_EWW_DIR:-$MIRA_DIR/eww}"
reloaded=""

signal_display() {
    sig=$1; name=$2; hit=0
    for p in $(pgrep -x "$name" 2>/dev/null); do
        d=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -n 1)
        if [ "$d" = "$DISPLAY" ]; then
            kill "-$sig" "$p" 2>/dev/null && hit=1
        fi
    done
    [ "$hit" -eq 1 ]
}

# Reload topbar
if command -v polybar-msg >/dev/null 2>&1 && polybar-msg cmd restart >/dev/null 2>&1; then
    reloaded="${reloaded}• Polybar\n"
fi

# Reload native notification center
if command -v NotifPanel >/dev/null 2>&1 && NotifPanel reload >/dev/null 2>&1; then
    reloaded="${reloaded}• Notifications\n"
fi

# Reload picom, xsettingsd, sxhkd (scoped to this display)
signal_display USR1 picom && reloaded="${reloaded}• Picom\n"
signal_display HUP xsettingsd && reloaded="${reloaded}• GTK Settings\n"
signal_display USR1 sxhkd && reloaded="${reloaded}• SXHKD\n"

# Reload eww panels (volume/music)
if command -v eww >/dev/null 2>&1 && eww ping -c "$main_eww" >/dev/null 2>&1; then
    eww reload -c "$main_eww" >/dev/null 2>&1 && reloaded="${reloaded}• Eww Panels\n"
fi

if [ -n "$reloaded" ] && command -v notify-send >/dev/null 2>&1; then
    notify-send -a Mira -i dialog-information "Mira Reloaded" "$(printf '%b' "$reloaded")"
fi
