MIRA_DIR="${MIRA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bspwm}"
export MIRA_CONFIG_DIR="$MIRA_DIR"
export PATH="$MIRA_DIR/bin:$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP='bspwm'
export XDG_SESSION_TYPE='x11'
export XDG_SESSION_DESKTOP='bspwm'
export _JAVA_AWT_WM_NONREPARENTING=1

# -- Monitors & workspaces --
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true
MonitorSetup

# -- BSPWM layout defaults --
bspc config external_rules_command "${MIRA_DIR}/bin/ExternalRules"
bspc config window_gap                5
bspc config split_ratio               0.51
bspc config single_monocle            true
bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

# Focus only on click or keyboard (hovering never scrolls a column strip).
bspc config focus_follows_pointer     false
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

# -- Scrolling columns daemon (src/misa-scroll) --
"${MIRA_DIR}/bin/Scroll" init >/dev/null 2>&1 &

# Helper: start a process only if not already running on this X display.
run_display() {
    cmd=$1
    for p in $(pgrep -x "$cmd" 2>/dev/null); do
        d=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -n 1)
        [ "$d" = "${DISPLAY:-:0}" ] && return 0
    done
    "$@" >/dev/null 2>&1 &
}

# Optional multi-session profile switcher (skipped in sandbox or if absent).
if [ -z "${MIRA_SANDBOX:-}" ] && [ -x "${HOME}/.local/bin/session-profile" ]; then
    "${HOME}/.local/bin/session-profile" misa >/dev/null 2>&1 || true
fi

# Detect hardware paths for polybar (network interface, backlight, battery).
"${MIRA_DIR}/bin/SetSysVars"

# X11 cursor, DPI & keyboard layout
xsetroot -cursor_name left_ptr 2>/dev/null || true
echo "Xft.dpi: 96" | xrdb -merge 2>/dev/null || true
setxkbmap -layout us 2>/dev/null || true

# Start picom first so polybar/GTK/eww obtain an ARGB visual.
if [ -z "${MIRA_NO_PICOM:-}" ] && command -v picom >/dev/null 2>&1; then
    # PicomWatch restarts picom if it dies and logs why (~/.cache/mira/picom.log).
    "${MIRA_DIR}/bin/PicomWatch" --config "${MIRA_DIR}/config/picom/picom.conf" >/dev/null 2>&1 &
    "${MIRA_DIR}/bin/WaitCompositor" 2>/dev/null || sleep 0.5
fi

# Native notification daemon & Notification Center (org.freedesktop.Notifications)
if [ -x "${MIRA_DIR}/bin/NotifPanel" ]; then
    "${MIRA_DIR}/bin/NotifPanel" --daemon >/dev/null 2>&1 &
fi

# Native clipboard history daemon (text + PNG)
if [ -x "${MIRA_DIR}/bin/misa-clip" ]; then
    "${MIRA_DIR}/bin/misa-clip" daemon --config "${MIRA_DIR}/config/clip.conf" >/dev/null 2>&1 &
fi

# Hotkey daemon
run_display sxhkd -c "${MIRA_DIR}/config/sxhkdrc"

# Apply active theme (colors, wallpaper, picom settings, xsettingsd, topbar)
"${MIRA_DIR}/bin/Theme.sh"

# Notify picom of any theme-driven config updates (display-scoped).
for p in $(pgrep -x picom 2>/dev/null); do
    d=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -n 1)
    [ "$d" = "${DISPLAY:-:0}" ] && kill -USR1 "$p" 2>/dev/null || true
done

# Session supervisors & resident popups
"${MIRA_DIR}/bin/MonitorWatch" >/dev/null 2>&1 &
"${MIRA_DIR}/bin/BarWatch" >/dev/null 2>&1 &
"${MIRA_DIR}/bin/MediaPill" >/dev/null 2>&1 &
"${MIRA_DIR}/bin/ClipPanel" --daemon >/dev/null 2>&1 &
"${MIRA_DIR}/bin/WifiPanel" --daemon >/dev/null 2>&1 &

# Keep polybar's layout indicator synchronized on desktop/monitor focus.
if command -v polybar-msg >/dev/null 2>&1; then
    (
        if command -v flock >/dev/null 2>&1; then
            exec 9>"${XDG_RUNTIME_DIR:-/tmp}/mira-layout-hook.lock"
            flock -n 9 || exit 0
        fi
        bspc subscribe desktop_focus monitor_focus 9>&- | while read -r _; do
            polybar-msg action "#layout.hook.0" >/dev/null 2>&1 || true
        done
    ) >/dev/null 2>&1 &
fi

# Eww daemon for Sound & Music topbar panels
if command -v eww >/dev/null 2>&1; then
    eww -c "${BSPWM_EWW_DIR:-$MIRA_DIR/eww}" daemon >/dev/null 2>&1 &
fi

# Polkit agent (skip in isolated test sandboxes)
if [ -z "${MIRA_SANDBOX:-}" ] && command -v lxpolkit >/dev/null 2>&1; then
    run_display lxpolkit
fi

# Background Debian apt updates counter (zero polling in polybar, 30 min cadence)
if [ -z "${MIRA_SANDBOX:-}" ] && [ -x "${MIRA_DIR}/bin/Updates" ]; then
    (
        if command -v flock >/dev/null 2>&1; then
            exec 9>"${XDG_RUNTIME_DIR:-/tmp}/mira-updates.lock"
            flock -n 9 || exit 0
        fi
        while :; do
            "${MIRA_DIR}/bin/Updates" --sync-bars 9>&-
            sleep 1800 9>&-
        done
    ) >/dev/null 2>&1 &
fi
