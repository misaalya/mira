@import "shared.rasi"

configuration {
    show-icons:                     true;
    click-to-exit:                  true;
}

window {
    location:                       center;
    transparency:                   "real";
    border:                         1px;
    border-radius:                  14px;
    border-color:                   @border-soft;
    background-color:               @background;
}

mainbox {
    children:                       [ "listview" ];
    padding:                        12px;
    background-color:               transparent;
}

listview {
    columns:                        5;
    lines:                          1;
    spacing:                        8px;
    cycle:                          true;
    dynamic:                        true;
    scrollbar:                      false;
    layout:                         vertical;
    background-color:               transparent;
    text-color:                     @foreground;
}

element {
    spacing:                        8px;
    padding:                        10px;
    orientation:                    vertical;
    border-radius:                  10px;
    cursor:                         pointer;
    background-color:               @surface-soft;
    text-color:                     @foreground;
}

element selected.normal {
    background-color:               @selected-soft;
    text-color:                     @foreground;
}

element-icon {
    size:                           160px;
    cursor:                         inherit;
    background-color:               transparent;
    text-color:                     inherit;
    border-radius:                  8px;
}

element-text {
    vertical-align:                 0.5;
    horizontal-align:               0.5;
    padding:                        0px;
    cursor:                         inherit;
    background-color:               transparent;
    text-color:                     inherit;
}
